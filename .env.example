# ───────────────────────── Producción con Docker Compose / Coolify ─────────────────────────
POSTGRES_USER=reloj
POSTGRES_PASSWORD=CAMBIAR_CLAVE_LARGA_DE_BD
POSTGRES_DB=reloj_saas
# URL pública (con https). Se usa en enlaces de correo, SEO y validación de Origin.
APP_URL=https://tudominio.com
# Secreto largo y aleatorio (>= 32 chars). Deriva el índice de los PIN: NO lo cambies con datos en producción.
APP_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
COOKIE_SECURE=true
REQUIRE_EMAIL_VERIFICATION=true
NEXT_PUBLIC_BRAND_NAME=ChecaFácil
WEB_PORT=3000
BACKUP_KEEP_DAYS=14

# Correo saliente (si SMTP_HOST está vacío los enlaces sólo se imprimen en el log del API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ChecaFácil <no-reply@tudominio.com>"

# Administrador SaaS (se crea la primera vez que arranca el API; después cambia la clave desde el flujo seguro)
PLATFORM_ADMIN_EMAIL=admin@tudominio.com
PLATFORM_ADMIN_PASSWORD=CAMBIAR_CONTRASEÑA_LARGA
# true = el admin SaaS debe activar MFA (TOTP) en su primer ingreso
PLATFORM_REQUIRE_MFA=true
SEED_DEMO=false

# ───────────────────────── Sólo desarrollo local (sin Docker) ─────────────────────────
# DATABASE_URL="postgresql://usuario:clave@localhost:5432/reloj_saas?schema=public"
# TEST_DATABASE_URL="postgresql://usuario:clave@localhost:5432/reloj_saas_test?schema=public"
# API_PORT=4000
# API_INTERNAL_URL="http://localhost:4000"
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
